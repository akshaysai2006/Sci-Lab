marks = input("Enter the marks: ");
if marks < 0 | marks > 100 then
disp("Invalid marks");
elseif marks >= 90 then
disp("Grade = A+");
elseif marks >= 80 then
disp("Grade = A");
elseif marks >= 70 then
disp("Grade = B");
elseif marks >= 60 then
disp("Grade = C");
elseif marks >= 50 then
disp("Grade = D");
else
disp("Grade = F");
end
